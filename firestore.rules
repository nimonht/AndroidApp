rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is the owner of a document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Get quiz data from database
    function getQuiz(quizId) {
      return get(/databases/$(database)/documents/quizzes/$(quizId)).data;
    }

    // Check if user owns the quiz
    function isQuizOwner(quizId) {
      return isSignedIn() && request.auth.uid == getQuiz(quizId).ownerId;
    }

    // Check if document is not soft-deleted
    function notDeleted() {
      return !('deletedAt' in resource.data) || resource.data.deletedAt == null;
    }

    // Check if quiz is accessible (public or has a share code)
    function isQuizAccessible() {
      return notDeleted() && (
        resource.data.isPublic == true
        || resource.data.shareCode != null
      );
    }

    // Check if quiz (by ID) is accessible to non-owners
    function isQuizAccessibleById(quizId) {
      let quiz = getQuiz(quizId);
      return quiz.isPublic == true || quiz.shareCode != null;
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================

    match /users/{userId} {
      // Any authenticated user can read user profiles
      allow read: if isSignedIn();

      // Users can only create/update/delete their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ============================================================================
    // QUIZZES COLLECTION
    //
    // Local-first sync: the client saves to Room first with local timestamps,
    // then syncs the full quiz graph to Firestore in the background. Therefore
    // we do NOT enforce request.time equality or zero-count constraints on
    // create – these would block every sync attempt.
    // ============================================================================

    match /quizzes/{quizId} {
      // Owner can always read their quizzes (including soft-deleted ones for
      // trash / restore). Non-owners can read non-deleted quizzes that are
      // either public or shared via share code.
      allow read: if isOwner(resource.data.ownerId)
        || isQuizAccessible();

      // Authenticated users can create quizzes they own
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // Only the owner can update; ownerId is immutable
      // Or anyone can update IF they are ONLY incrementing the attemptCount by 1
      allow update: if (isOwner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attemptCount'])
          && request.resource.data.attemptCount == resource.data.attemptCount + 1
        );

      // Only the owner can delete
      allow delete: if isOwner(resource.data.ownerId);

      // ========================================================================
      // QUESTIONS SUBCOLLECTION
      // ========================================================================

      match /questions/{questionId} {
        // Quiz owner or readers of accessible quizzes (public or share-code)
        allow read: if isQuizOwner(quizId) || isQuizAccessibleById(quizId);

        // Only quiz owner can write questions
        allow write: if isQuizOwner(quizId);

        // ======================================================================
        // CHOICES SUBCOLLECTION
        // ======================================================================

        match /choices/{choiceId} {
          // Quiz owner or readers of accessible quizzes (public or share-code)
          allow read: if isQuizOwner(quizId) || isQuizAccessibleById(quizId);

          // Only quiz owner can write choices
          allow write: if isQuizOwner(quizId);
        }
      }
    }

    // ============================================================================
    // ATTEMPTS COLLECTION
    // ============================================================================

    match /attempts/{attemptId} {
      // Attempt owner or quiz owner can read
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId)
        || isQuizOwner(resource.data.quizId)
      );

      // Authenticated users create attempts for themselves; guests can also create
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid)
        || request.resource.data.userId.matches('guest_.*');

      // Only the attempt owner can update
      allow update: if (isSignedIn() && isOwner(resource.data.userId))
        || resource.data.userId.matches('guest_.*');

      // Attempt owner or quiz owner can delete
      allow delete: if isSignedIn() && (
        isOwner(resource.data.userId)
        || isQuizOwner(resource.data.quizId)
      );
    }

    // ============================================================================
    // QUESTION POOL COLLECTION
    // ============================================================================

    match /questionPool/{poolId} {
      // Anyone can read pool questions
      allow read: if true;

      // Authenticated users can contribute questions
      allow create: if isSignedIn();

      // Only the contributor can update (or anonymous contributions)
      allow update: if isSignedIn() && (
        !('contributorId' in resource.data)
        || resource.data.contributorId == null
        || isOwner(resource.data.contributorId)
      );

      // Only the contributor can delete (or anonymous contributions)
      allow delete: if isSignedIn() && (
        !('contributorId' in resource.data)
        || resource.data.contributorId == null
        || isOwner(resource.data.contributorId)
      );
    }

    // ============================================================================
    // SHARE CODES COLLECTION
    //
    // Share codes are managed client-side (generated by ShareCodeUtil).
    // Any authenticated user can create/update/delete share codes.
    // ============================================================================

    match /shareCodes/{code} {
      // Anyone can look up a share code (for quiz joining)
      allow read: if true;

      // Authenticated users can manage share codes
      allow write: if isSignedIn();
    }
  }
}
