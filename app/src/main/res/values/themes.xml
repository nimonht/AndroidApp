<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (light). -->
    <style name="Base.Theme.AndroidApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorPrimaryInverse">@color/inverse_primary_light</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_light</item>
        <item name="colorOnSecondaryContainer">@color/brand_secondary_dark</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/brand_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/brand_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/brand_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Background / Surface -->
        <item name="colorBackground">@color/background_light</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/on_background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>
        <item name="colorInverseSurface">@color/inverse_surface_light</item>
        <item name="colorInverseOnSurface">@color/inverse_on_surface_light</item>
        <item name="colorSurfaceTint">@color/surface_tint_light</item>
        <item name="colorSurfaceBright">@color/surface_bright_light</item>
        <item name="colorSurfaceDim">@color/surface_dim_light</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest_light</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low_light</item>
        <item name="colorSurfaceContainer">@color/surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high_light</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>
    </style>

    <style name="Theme.AndroidApp" parent="Base.Theme.AndroidApp" />
</resources>
